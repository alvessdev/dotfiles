-  print \$0"\0icon\x1f${thumbnail_dir}/"thumbnail_file
-  next
-}
-1
-EOF
-
-item=$(echo "$cliphist_list" | gawk "$thumbnail" | fuzzel -d --placeholder "Search clipboard..." --counter --no-sort --with-nth 2)
