prefer-no-csd

hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    // skip-at-startup
}

environment {
	GDK_BACKEND "wayland,x11,*"
	QT_QPA_PLATFORM "wayland;xcb"
	QT_QPA_PLATFORMTHEME "qt6ct"
	XDG_SESSION_TYPE "wayland"
}

cursor {
	xcursor-theme "Vimix"
}
