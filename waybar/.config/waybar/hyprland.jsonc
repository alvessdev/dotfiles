{
	"include": [
		"main.jsonc"
	],
	// Choose the order of the modules
	"modules-left": [
		"custom/arch",
		"hyprland/workspaces",
	],
	"modules-center": [
		"hyprland/window",
	],
	"modules-right": [
		"tray",
		"hyprland/language",
		"cpu",
		"memory",
		"disk",
		"clock",
		"custom/power"
	],
	"hyprland/workspaces": {
		"active-only": false,
		"hide-active": false,
		"format": "&#x202b;{icon}&#x202c;",
		"format-icons": {
			"11": " 󰊗",
			"12": " ",
			//	"active": "",
			//	"default": ""
		},
		"show-special": true,
		"special-visible-only": true,
		//	"persistent-workspaces": {
		//		"*": 5, // 5 workspaces by default on every monitor
		//	}
	},
	"custom/power": {
		"format": "⏻ ",
		"tooltip": false,
		"on-click": "nwg-bar -t hyprland.json"
	},
	"hyprland/language": {
		"format": "{}",
		"format-en": "US",
		"format-en-intl": "US-INTL",
		"format-pt": "PT-BR",
		"on-click": "hyprctl switchxkblayout compx-2.4g-wireless-receiver-keyboard next"
	}
}
