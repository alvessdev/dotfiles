{
	"include": [
		"main.jsonc"
	],
	// Choose the order of the modules
	"modules-left": [
		"custom/arch",
		"niri/workspaces",
	],
	"modules-center": [
		"niri/window",
	],
	"modules-right": [
		"tray",
		"niri/language",
		"cpu",
		"memory",
		"disk",
		"clock",
		"custom/power"
	],
	"niri/workspaces": {
		"format": "{icon}",
		"format-icons": {
			// Named workspaces
			// (you need to configure them in niri)
			// Icons by state
			"active": "",
			"default": ""
		},
	},
	"custom/power": {
		"format": "⏻ ",
		"tooltip": false,
		"on-click": "nwg-bar -t niri.json"
	},
	"niri/language": {
		"format": "{}",
		"format-en": "US",
		"format-en-intl": "US-INTL",
		"format-pt": "PT-BR",
		"on-click": "niri msg action switch-layout next"
	}
}
